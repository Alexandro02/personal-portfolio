---

---

<dialog id="contact-modal" class="contact-modal rounded-none p-0">
  <form id="contact-form" class="contact-modal-form" novalidate>
    <div
      class="flex items-center justify-between border-b px-6 py-4"
      style="border-color: var(--line-strong);"
    >
      <h3
        class="font-mono uppercase tracking-wide text-sm"
        data-i18n-es="Escríbeme"
        data-i18n-en="Email me"
      >
        Escríbeme
      </h3>
      <button
        type="button"
        data-close-modal
        class="opacity-60 hover:opacity-100 font-mono text-lg leading-none"
        aria-label="Cerrar / Close">×</button
      >
    </div>

    <div class="flex flex-col gap-4 px-6 py-5">
      <label class="flex flex-col gap-1">
        <span
          class="font-mono text-xs uppercase tracking-wide opacity-70"
          data-i18n-es="Nombre"
          data-i18n-en="Name">Nombre</span
        >
        <input
          type="text"
          name="name"
          required
          maxlength="200"
          class="input input-bordered rounded-none w-full"
        />
      </label>

      <label class="flex flex-col gap-1">
        <span
          class="font-mono text-xs uppercase tracking-wide opacity-70"
          data-i18n-es="Correo"
          data-i18n-en="Email">Correo</span
        >
        <input
          type="email"
          name="email"
          required
          maxlength="200"
          class="input input-bordered rounded-none w-full"
        />
      </label>

      <label class="flex flex-col gap-1">
        <span
          class="font-mono text-xs uppercase tracking-wide opacity-70"
          data-i18n-es="Mensaje"
          data-i18n-en="Message">Mensaje</span
        >
        <textarea
          name="message"
          required
          maxlength="5000"
          rows="4"
          class="textarea textarea-bordered rounded-none w-full"></textarea>
      </label>

      <!-- honeypot: campo oculto, si un bot lo llena tratamos el envío como spam -->
      <label class="hidden" aria-hidden="true">
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>

      <p
        data-form-status
        class="hidden font-mono text-xs uppercase tracking-wide"
        role="status"
      >
      </p>

      <div class="flex justify-end gap-3 pt-1">
        <button
          type="button"
          data-close-modal
          class="btn btn-outline rounded-none font-mono uppercase tracking-wide"
          data-i18n-es="Cancelar"
          data-i18n-en="Cancel">Cancelar</button
        >
        <button
          type="submit"
          data-submit-btn
          class="btn btn-primary rounded-none font-mono uppercase tracking-wide"
          data-i18n-es="Enviar"
          data-i18n-en="Send">Enviar</button
        >
      </div>
    </div>
  </form>
</dialog>

<style>
  .contact-modal {
    border: 1px solid var(--line-strong);
    background: var(--color-base-200);
    color: var(--color-base-content);
    width: min(30rem, calc(100% - 2rem));
    /* Tailwind preflight resets margin to 0, which breaks the native
       dialog centering (it relies on margin: auto). Re-center manually. */
    position: fixed;
    inset: 0;
    margin: auto;

    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      overlay 0.2s allow-discrete,
      display 0.2s allow-discrete;
  }
  .contact-modal[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  @starting-style {
    .contact-modal[open] {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  .contact-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      overlay 0.2s allow-discrete,
      display 0.2s allow-discrete;
  }
  .contact-modal[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .contact-modal[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-modal,
    .contact-modal::backdrop {
      transition: none;
    }
  }

  .contact-modal-form {
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  const dialog = document.getElementById(
    "contact-modal",
  ) as HTMLDialogElement | null;
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const statusEl = document.querySelector<HTMLElement>("[data-form-status]");
  const submitBtn =
    document.querySelector<HTMLButtonElement>("[data-submit-btn]");

  if (dialog && form && statusEl && submitBtn) {
    document
      .querySelectorAll<HTMLElement>("[data-open-contact-modal]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          statusEl.classList.add("hidden");
          dialog.showModal();
        });
      });

    dialog
      .querySelectorAll<HTMLElement>("[data-close-modal]")
      .forEach((btn) => {
        btn.addEventListener("click", () => dialog.close());
      });

    // Cerrar al hacer click en el backdrop (fuera del <form>).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    const STATUS_TEXT = {
      es: {
        sending: "Enviando...",
        success: "¡Mensaje enviado! Te responderé pronto.",
        error: "Algo salió mal. Intenta de nuevo o escríbeme directo.",
      },
      en: {
        sending: "Sending...",
        success: "Message sent! I'll get back to you soon.",
        error: "Something went wrong. Please try again or email me directly.",
      },
    };

    function currentLang(): "es" | "en" {
      return localStorage.getItem("lang") === "en" ? "en" : "es";
    }

    function showStatus(kind: "sending" | "success" | "error") {
      statusEl!.textContent = STATUS_TEXT[currentLang()][kind];
      statusEl!.classList.remove("hidden");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());

      submitBtn.disabled = true;
      showStatus("sending");

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json();

        if (res.ok && json.ok) {
          showStatus("success");
          form.reset();
          setTimeout(() => dialog.close(), 1600);
        } else {
          showStatus("error");
        }
      } catch {
        showStatus("error");
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>
