---
const links = [
  { id: "hero", href: "#hero", es: "Inicio", en: "Home" },
  { id: "projects", href: "#projects", es: "Proyectos", en: "Projects" },
  { id: "about", href: "#about", es: "Sobre mí", en: "About" },
  { id: "contact", href: "#contact", es: "Contacto", en: "Contact" },
];
---

<nav class="site-nav" aria-label="Primary">
  <button
    type="button"
    data-nav-toggle
    class="site-nav-toggle"
    aria-expanded="false"
    aria-controls="site-nav-pill"
    aria-label="Abrir menú / Open menu"
  >
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <div class="site-nav-pill" id="site-nav-pill">
    <ul class="site-nav-links" role="list">
      {links.map((link, i) => (
        <li style={`--i:${i}`}>
          <a href={link.href} data-nav-link data-nav-id={link.id} class="site-nav-link">
            <span class="site-nav-dot" aria-hidden="true"></span><span data-i18n-es={link.es} data-i18n-en={link.en}>{link.es}</span>
          </a>
        </li>
      ))}
    </ul>

    <span class="site-nav-sep" aria-hidden="true"></span>

    <div class="site-nav-controls">
      <button type="button" data-lang-toggle class="site-nav-icon-btn" style={`--i:${links.length}`} aria-label="Cambiar idioma / Switch language">
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        <span class="sr-only" data-lang-label>English</span>
      </button>

      <button type="button" data-theme-toggle class="site-nav-icon-btn" style={`--i:${links.length + 1}`} aria-label="Cambiar tema / Toggle theme">
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><line x1="12" y1="2" x2="12" y2="4"></line><line x1="12" y1="20" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="4" y2="12"></line><line x1="20" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="6.34" y2="17.66"></line><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"></line></svg>
        <span class="sr-only" data-theme-label>Claro</span>
      </button>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 1rem;
    left: 0.75rem;
    right: 0.75rem;
    width: fit-content;
    margin-inline: auto;
    z-index: 50;
  }

  /* ---------- hamburger toggle (mobile only) ---------- */

  .site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--color-base-200);
    border: 1px solid var(--line-strong);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(10px);
    flex-shrink: 0;
  }
  .site-nav-toggle .bar {
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-base-content);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.2s ease;
  }
  .site-nav.is-open .site-nav-toggle .bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-nav.is-open .site-nav-toggle .bar:nth-child(2) {
    opacity: 0;
  }
  .site-nav.is-open .site-nav-toggle .bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-nav-pill {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.35rem;
    border-radius: 999px;
    background: var(--color-base-200);
    border: 1px solid var(--line-strong);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(10px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav-pill::-webkit-scrollbar {
    display: none;
  }

  .site-nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav-links li {
    display: flex;
  }

  .site-nav-controls {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .site-nav-link {
    display: flex;
    align-items: center;
    white-space: nowrap;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--paper-dim);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .site-nav-link:hover {
    color: var(--color-base-content);
  }
  .site-nav-link.is-active {
    color: var(--color-base-content);
    background: var(--color-base-300);
    font-weight: 600;
  }

  .site-nav-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
    margin-right: 0.4rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .site-nav-link.is-active .site-nav-dot {
    opacity: 1;
  }

  .site-nav-sep {
    width: 1px;
    height: 1.2rem;
    background: var(--line-strong);
    margin: 0 0.15rem;
    flex-shrink: 0;
  }

  .site-nav-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    color: var(--paper-dim);
    flex-shrink: 0;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .site-nav-icon-btn:hover {
    color: var(--color-base-content);
    background: var(--color-base-300);
  }

  /* ---------- mobile: links float in, no card/box ---------- */

  @media (max-width: 767px) {
    .site-nav {
      width: auto;
      display: flex;
      justify-content: center;
    }

    .site-nav-toggle {
      display: flex;
    }

    .site-nav-pill {
      position: absolute;
      top: calc(100% + 0.8rem);
      right: 0;
      left: auto;
      transform: none;
      background: linear-gradient(
        to left,
        color-mix(in srgb, var(--color-base-100) 88%, transparent) 0%,
        color-mix(in srgb, var(--color-base-100) 60%, transparent) 55%,
        transparent 100%
      );
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: none;
      box-shadow: none;
      border-radius: 1.25rem;
      flex-direction: column;
      align-items: flex-end;
      width: max-content;
      max-width: 100%;
      max-height: 0;
      padding: 0.9rem 1rem 0.9rem 2.5rem;
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
      transition:
        max-height 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
        opacity 0.25s ease;
    }
    .site-nav.is-open .site-nav-pill {
      max-height: 26rem;
      opacity: 1;
      pointer-events: auto;
    }

    .site-nav-links {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.15rem;
    }
    .site-nav-link {
      font-size: 0.85rem;
    }

    .site-nav-sep {
      width: 100%;
      height: 1px;
      background: var(--line);
      margin: 0.5rem 0;
    }

    .site-nav-controls {
      justify-content: flex-end;
      gap: 0.6rem;
    }

    /* cascade: each item slides in from the right with a staggered delay */
    .site-nav-links li,
    .site-nav-controls .site-nav-icon-btn {
      opacity: 0;
      transform: translateX(28px);
      transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: 0s;
    }
    .site-nav.is-open .site-nav-links li,
    .site-nav.is-open .site-nav-controls .site-nav-icon-btn {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i, 0) * 45ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav-toggle .bar,
    .site-nav-pill,
    .site-nav-links li,
    .site-nav-controls .site-nav-icon-btn {
      transition: none !important;
    }
  }
</style>

<script>
  const LANG_KEY = "lang";
  const THEME_KEY = "theme";
  const THEME_LABELS: Record<string, { dark: string; light: string }> = {
    es: { dark: "Oscuro", light: "Claro" },
    en: { dark: "Dark", light: "Light" },
  };

  function currentLang(): string {
    return localStorage.getItem(LANG_KEY) || "es";
  }

  function updateThemeLabel() {
    const label = document.querySelector<HTMLElement>("[data-theme-label]");
    if (!label) return;
    const theme = document.documentElement.getAttribute("data-theme") === "infra-light" ? "light" : "dark";
    const target = theme === "light" ? "dark" : "light";
    label.textContent = THEME_LABELS[currentLang()][target];
  }

  const pill = document.querySelector<HTMLElement>(".site-nav-pill");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isDesktop = () => window.matchMedia("(min-width: 768px)").matches;
  const TEXT_FADE_MS = 150;

  function applyLang(lang: string, animate: boolean = true) {
    document.documentElement.lang = lang;
    const els = Array.from(document.querySelectorAll<HTMLElement>("[data-i18n-es]"));

    function commitText() {
      els.forEach((el) => {
        const text = lang === "en" ? el.dataset.i18nEn : el.dataset.i18nEs;
        if (text !== undefined) el.textContent = text;
      });
      const label = document.querySelector<HTMLElement>("[data-lang-label]");
      if (label) label.textContent = lang === "es" ? "English" : "Español";
      updateThemeLabel();
      window.dispatchEvent(new CustomEvent("langchange", { detail: { lang } }));
    }

    // The pill width-morph animation only makes sense for the horizontal
    // desktop pill; on mobile the panel is a fixed-width dropdown.
    if (!animate || prefersReducedMotion || !els.length || !isDesktop()) {
      commitText();
      return;
    }

    // Fade out, swap text + animate pill width together, fade back in.
    els.forEach((el) => (el.style.opacity = "0"));
    if (pill) pill.style.overflow = "hidden";

    window.setTimeout(() => {
      const oldPillWidth = pill ? pill.getBoundingClientRect().width : null;

      commitText();

      if (pill && oldPillWidth !== null) {
        const newPillWidth = pill.getBoundingClientRect().width;
        if (Math.abs(newPillWidth - oldPillWidth) >= 0.5) {
          pill.style.transition = "none";
          pill.style.width = `${oldPillWidth}px`;
          pill.getBoundingClientRect();
          requestAnimationFrame(() => {
            pill.style.transition = "width 0.25s cubic-bezier(0.2, 0.7, 0.2, 1)";
            pill.style.width = `${newPillWidth}px`;
          });
          pill.addEventListener(
            "transitionend",
            function handler(e) {
              if (e.propertyName !== "width") return;
              pill.style.transition = "";
              pill.style.width = "";
              pill.style.overflow = "";
              pill.removeEventListener("transitionend", handler);
            }
          );
        } else {
          pill.style.overflow = "";
        }
      }

      els.forEach((el) => (el.style.opacity = ""));
    }, TEXT_FADE_MS);
  }

  const storedLang = localStorage.getItem(LANG_KEY) || "es";
  applyLang(storedLang, false);

  document.querySelector("[data-lang-toggle]")?.addEventListener("click", () => {
    const current = localStorage.getItem(LANG_KEY) || "es";
    const next = current === "es" ? "en" : "es";
    localStorage.setItem(LANG_KEY, next);
    applyLang(next);
  });

  function applyTheme(theme: string) {
    document.documentElement.setAttribute("data-theme", theme);
    updateThemeLabel();
  }

  const storedTheme = document.documentElement.getAttribute("data-theme") || "infra";
  applyTheme(storedTheme);

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme") === "infra-light" ? "infra-light" : "infra";
    const next = current === "infra" ? "infra-light" : "infra";
    localStorage.setItem(THEME_KEY, next);
    applyTheme(next);
  });

  // ---------- mobile hamburger menu ----------
  const siteNav = document.querySelector<HTMLElement>(".site-nav");
  const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");

  function closeMobileNav() {
    siteNav?.classList.remove("is-open");
    navToggle?.setAttribute("aria-expanded", "false");
  }
  function openMobileNav() {
    siteNav?.classList.add("is-open");
    navToggle?.setAttribute("aria-expanded", "true");
  }

  navToggle?.addEventListener("click", () => {
    if (siteNav?.classList.contains("is-open")) closeMobileNav();
    else openMobileNav();
  });

  document.addEventListener("click", (e) => {
    if (!siteNav || !siteNav.classList.contains("is-open")) return;
    if (!siteNav.contains(e.target as Node)) closeMobileNav();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMobileNav();
  });

  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) closeMobileNav();
  });

  // ---------- scrollspy: resalta el link de la sección visible ----------
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
  const linkById = new Map(navLinks.map((el) => [el.dataset.navId, el]));

  navLinks.forEach((link) => link.addEventListener("click", () => closeMobileNav()));

  function setActive(id: string | undefined) {
    if (!id) return;
    navLinks.forEach((el) => el.classList.toggle("is-active", el.dataset.navId === id));
  }

  if ("IntersectionObserver" in window && navLinks.length) {
    const targets = Array.from(linkById.keys())
      .map((id) => (id ? document.getElementById(id) : null))
      .filter((el): el is HTMLElement => Boolean(el));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
    );
    targets.forEach((el) => observer.observe(el));
  }

  setActive("hero");
</script>
